# Auto-detect text files and normalize line endings
* text=auto

# Specify LF line endings for text source files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
